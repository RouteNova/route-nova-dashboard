# URL de la API del Backend de RouteNova (HTTPS en producción, HTTP en desarrollo local)
VITE_API_URL=http://localhost:5000/api

# Nombre de la aplicación
VITE_APP_NAME=RouteNova Dashboard

# Token público de Mapbox GL (Restringir por URL/dominio en la consola de Mapbox)
# Obtener en https://account.mapbox.com/
VITE_MAPBOX_ACCESS_TOKEN=pk.tu_token_publico_aqui
